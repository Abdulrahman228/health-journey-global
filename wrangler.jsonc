    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_yZch0ixRiNtHxjL0PFGXXg_RFdyLcWK",
    "VITE_SITE_URL": "https://mytabibi.com",
    "VITE_SUPABASE_URL": "https://wqrrwvaxovrjjiilqkmt.supabase.co",
    "VITE_SUPABASE_PROJECT_ID": "wqrrwvaxovrjjiilqkmt",
    "VITE_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_yZch0ixRiNtHxjL0PFGXXg_RFdyLcWK"
  },
  "observability": { "enabled": true }
