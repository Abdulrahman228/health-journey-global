# Copy this file to .env and fill in real values.
# Never commit your .env file.

SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_PROJECT_ID=<your-project-ref>
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Google Maps (browser key — restricted by HTTP referrer in Google Cloud Console)
VITE_LOVABLE_CONNECTOR_GOOGLE_MAPS_BROWSER_KEY=AIza...
VITE_LOVABLE_CONNECTOR_GOOGLE_MAPS_TRACKING_ID=

# Site
VITE_SITE_URL=https://mytabibi.com
